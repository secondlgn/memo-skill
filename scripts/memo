#!/usr/bin/env python3
"""
memo — 工作区注意力本本（single source of truth = index.json）

数据目录   : MEMO_DIR (默认 $CWD/memo)
索引表     : MEMO_DIR/index.json
条目文件   : MEMO_DIR/{NNN}-{描述}.md   (NNN 为当前排序序号)
滚动历史   : MEMO_DIR/history.ndjson     (只追加 append-only, 每行一条事件)
旧历史目录 : MEMO_DIR/history/           (兼容旧版 .md 格式, 仍在时要记住不删)

次命令:
  memo insert --desc STR [--importance 0.00-1.00] [--agent ID] [--note STR]
  memo update --id ID [--desc STR] [--importance FLOAT] [--agent ID]
  memo drop  --id ID
  memo view  [--scope workplace|agent] [--agent ID] [--top N] [--all]
  memo log   [--agent ID] [--top N] [--all]        (按时间顺序读历史)
  memo review [--top N] [--agent ID]               (按影响量找重大改变, 供回顾)
  memo tidy                                        (总结清理: 聚类/清理/归并候选)
  memo daydream [--n N] [--mix]                    (白日梦: 随机捞被遗忘的旧线索)
  memo playbook list|init|route                    (场景化种子备忘)

滚动历史为只追加 NDJSON:
  {"op": "...", "id": "...", "agent": "...", "ts": "...", "seq": N,
   "desc": "...", "imp": 0.90, "delta": +0.90, "old_imp": ..., "note": "..."}
  - delta = 本次操作对整个 memo 的重要性影响量
        insert : +新importance(新增注意力占比)
        update : +new_imp - old_imp(注意力升降)
        drop   : -importance(释放注意力)
  "重大改变回顾" = 按 |delta| 从大到小找影响最大的那几次操作。

设计要点:
- 序号是派生值，由索引表在每次 insert/update/drop 后重排并回写文件名。
- 并发: 每次变更用虚拟文件锁(哨兵文件 O_CREAT|O_EXCL)串行化, 防多 Agent 同时写 index/历史冲突。
  跨平台可靠。
- 重要性初值默认由调用方(模型)给出; 用户强调则按用户。
- 冲突(同一事实两条不同取值)必须消解, 不并缓存。
- 谁读谁现场算 top N, 输出量恒定可控。
"""
import argparse, json, os, re, sys, datetime, time

# ---------- 并发虚拟文件锁 (跨平台, 哨兵文件/独占创建) ----------
def file_lock(path, timeout=10):
    """上下文管理器: 对 path 加独占锁(哨兵文件 O_CREAT|O_EXCL, 跨平台可靠).
    用法:
      with memo_lock():
          do_mutation()
    用独立哨兵文件 .memo.lock 实现, 不锁数据文件本身, 数据仍可被多进程并发读。
    获得锁=成功独占创建哨兵文件; 释放=删除它。若有残留(进程崩溃)会永久锁死。
    失败重试直到超时抛 TimeoutLockError。
    """
    import time as _t
    LOCK = path
    class _Lock:
        def __init__(s, p, to):
            s.p, s.to, s.acquired = p, to, False
        def __enter__(s):
            os.makedirs(os.path.dirname(s.p), exist_ok=True)
            deadline = _t.time() + s.to
            while True:
                try:
                    fd = os.open(s.p, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
                    os.close(fd)
                    s.acquired = True
                    return s
                except (OSError, IOError):
                    # 锁文件已存在 = 他人持锁
                    if _t.time() > deadline:
                        raise TimeoutLockError(f"memo lock timeout: {s.p} (残留锁? 手动删除该文件)")
                    _t.sleep(0.05)
        def __exit__(s, *exc):
            if s.acquired:
                try:
                    os.remove(s.p)
                except FileNotFoundError:
                    pass
            return False
    return _Lock(path, timeout)

def memo_lock(timeout=10):
    return file_lock(LOCK_FILE, timeout)

os.chdir(os.path.dirname(os.path.abspath(__file__)) + "/..")
MEMO_DIR = os.getenv("MEMO_DIR", os.path.abspath("memo"))
INDEX = os.path.join(MEMO_DIR, "index.json")
HISTORY_NDJSON = os.path.join(MEMO_DIR, "history.ndjson")
HISTORY_DIR = os.path.join(MEMO_DIR, "history")  # 旧 .md 版本, 兼容只读
LOCK_FILE = os.path.join(MEMO_DIR, ".memo.lock")
PLAYBOOK_DIR = os.getenv("PLAYBOOK_DIR", os.path.join(os.path.dirname(os.path.abspath(__file__)), "../playbooks"))
GITHUB_REPO = os.getenv("MEMO_GITHUB_REPO", "https://github.com/secondlgn/memo-skill/issues/new")

# ---------- 历史(只追加 NDJSON) ----------
def _next_seq():
    """单调递增 seq, 供历史事件使用. 从 ndjson 满载最后一条 + 旧 .md 目录取 max."""
    m = 0
    if os.path.exists(HISTORY_NDJSON):
        try:
            with open(HISTORY_NDJSON, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        d = json.loads(line)
                        m = max(m, int(d.get("seq", 0)))
                    except Exception:
                        pass
        except Exception:
            pass
    if os.path.isdir(HISTORY_DIR):
        for name in os.listdir(HISTORY_DIR):
            prefix = name.split("-", 1)[0]
            if prefix.isdigit():
                m = max(m, int(prefix))
    return m + 1

def calc_delta(op, note):
    """计算一次操作对整个 memo 的重要性影响量 delta."""
    if op == "insert":
        return note.get("imp", 0.0)
    if op == "update":
        return (note.get("new_imp") or 0.0) - (note.get("old_imp") or 0.0)
    if op == "drop":
        return -(note.get("imp", 0.0))
    return 0.0

def append_history(note):
    """把一条事件追加到 history.ndjson (只追加). 调用方应已持有锁."""
    os.makedirs(MEMO_DIR, exist_ok=True)
    rec = {
        "op": note.get("op"), "id": note.get("id"),
        "agent": note.get("agent", "?"), "ts": note.get("ts") or datetime.datetime.now().isoformat(timespec="seconds"),
        "seq": note.get("seq", 0), "desc": note.get("desc", ""),
        "imp": note.get("imp"), "old_imp": note.get("old_imp"),
        "new_imp": note.get("new_imp"), "delta": note.get("delta"),
        "note": note.get("note", ""),
    }
    with open(HISTORY_NDJSON, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")

def read_all_history():
    """读历史: 新 ndjson + 旧 .md 目录(兼容)。按 seq 升序(时间先后)。"""
    out = []
    # 1) ndjson
    if os.path.exists(HISTORY_NDJSON):
        try:
            with open(HISTORY_NDJSON, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        out.append(json.loads(line))
                    except Exception:
                        pass
        except Exception:
            pass
    # 2) 旧 .md 目录 (只读兼容, 不写)
    if os.path.isdir(HISTORY_DIR):
        for fn in sorted(os.listdir(HISTORY_DIR)):
            if not fn.endswith(".md"):
                continue
            m = re.match(r"(\d+)-(\w+)-(.*)\.md", fn)
            if not m:
                continue
            rec = {"op": "?", "desc": fn}
            try:
                with open(os.path.join(HISTORY_DIR, fn), encoding="utf-8-sig") as f:
                    for line in f:
                        ls = line.strip()
                        if ls.startswith("- 操作"): rec["op"] = ls.split(":", 1)[1].strip()
                        elif ls.startswith("- Agent"): rec["agent"] = ls.split(":", 1)[1].strip()
                        elif ls.startswith("描述"): rec["desc"] = ls.split(":", 1)[1].strip()
                        elif ls.startswith("- 时间"):
                            try: rec["ts"] = ls.split(":", 1)[1].strip()
                            except Exception: pass
            except Exception:
                pass
            rec["seq"] = int(m.group(1)); rec["legacy"] = True
            out.append(rec)
    out.sort(key=lambda r: r.get("seq", 0))
    return out

def hist_desc(r, extra=""):
    imp = r.get("imp")
    if imp is None:
        impf = ""
    else:
        impf = f" imp={imp:.2f}"
    d = r.get("delta")
    df = f" delta={d:+.2f}" if d is not None else ""
    return f"({r.get('seq','?')}) [{r.get('op','?')}/{r.get('agent','?')}] {r.get('desc','')}{impf}{df}{extra}"

# ---------- 索引读写 ----------
def load():
    """读索引; 若目录/文件不存在则返回空结构并把目录建好。"""
    os.makedirs(MEMO_DIR, exist_ok=True)
    if not os.path.exists(INDEX):
        return {"schema": 1, "notes": [], "log": [], "log_count": 0}
    with open(INDEX, "r", encoding="utf-8-sig") as f:
        return json.load(f)

def save(data):
    os.makedirs(MEMO_DIR, exist_ok=True)
    with open(INDEX, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def clean_desc(s):
    s = re.sub(r"[\\/:*?\"<>|\s]+", "-", s.strip())
    return s[:12] or "untitled"

def fname(seq, desc):
    return f"{seq:03d}-{clean_desc(desc)}.md"

def renum(data):
    """按 (importance DESC, created DESC) 排序,重写序号,并重命名文件."""
    order = sorted(data["notes"], key=lambda n: -n.get("importance", 0))
    old = {}
    for n in data["notes"]:
        old[n["id"]] = n["_file"]
    renamed = []
    for i, n in enumerate(order):
        newseq = i + 1
        nf = fname(newseq, n["desc"])
        oldf = os.path.join(MEMO_DIR, n.get("_file", "")) if n.get("_file") else ""
        nfpath = os.path.join(MEMO_DIR, nf)
        if oldf and os.path.exists(oldf) and oldf != nfpath:
            os.rename(oldf, nfpath)
            renamed.append((os.path.basename(oldf), nf))
        elif not os.path.exists(nfpath):
            body = n.get("note", "") or ""
            if body.strip() == "" and n.get("desc"):
                body = n["desc"]
            open(nfpath, "w", encoding="utf-8").write(body)
        n["_file"] = nf
        n["seq"] = newseq
    save(data)
    return order, renamed

def _mutate(mutator):
    """通用变更封装: 加锁 -> 变更 index -> 追加历史 -> 释放锁。
    mutator(data): 修改 data, 返回要追加的 history note dict(含 op/id/agent/desc/delta 等)。
    """
    with memo_lock():
        data = load()
        note = mutator(data)
        renum(data)  # 内部会 save
        # 追加历史也在锁内, 保证 index 与 history 一致顺序
        note.setdefault("seq", _next_seq())
        note.setdefault("ts", datetime.datetime.now().isoformat(timespec="seconds"))
        note.setdefault("delta", calc_delta(note.get("op"), note))
        append_history(note)
        return note, data

# ---------- 业务命令 ----------
def insert(args):
    now = datetime.datetime.now().isoformat(timespec="seconds")
    new_id = args.id or (f"n{int(time.time()*1000)}")
    note = {
        "id": new_id, "desc": args.desc, "importance": args.importance,
        "agent": args.agent, "created": now, "updated": now,
        "note": args.note or "", "_file": "", "seq": 0,
    }
    def m(data):
        data["notes"].append(dict(note))
        return {"op": "insert", "id": new_id, "agent": args.agent,
                "desc": args.desc, "imp": args.importance, "note": args.note or ""}
    got, data = _mutate(m)
    seq = got["seq"]
    print(f"inserted {new_id}: {fname(seq, args.desc)} (importance={args.importance})")

def update(args):
    def m(data):
        old = None
        for n in data["notes"]:
            if n["id"] == args.id:
                old = dict(n)
                if args.desc: n["desc"] = args.desc
                if args.importance is not None: n["importance"] = args.importance
                if args.agent: n["agent"] = args.agent
                if args.note: n["note"] = args.note
                n["updated"] = datetime.datetime.now().isoformat(timespec="seconds")
                break
        if old is None:
            raise KeyError(args.id)
        return {"op": "update", "id": args.id, "agent": args.agent or old.get("agent"),
                "desc": args.desc or old["desc"], "old_imp": old["importance"],
                "new_imp": args.importance if args.importance is not None else old["importance"],
                "note": args.note or ""}
    try:
        got, data = _mutate(m)
        print(f"updated {args.id} (delta={got['delta']:+.2f})")
    except KeyError:
        print(f"id not found: {args.id}"); sys.exit(1)

def drop(args):
    def m(data):
        victim = next((n for n in data["notes"] if n["id"] == args.id), None)
        if not victim:
            raise KeyError(args.id)
        data["notes"] = [n for n in data["notes"] if n["id"] != args.id]
        return {"op": "drop", "id": args.id, "agent": victim.get("agent"),
                "desc": victim["desc"], "imp": victim.get("importance"),
                "note": victim.get("note", "")}
    try:
        got, data = _mutate(m)
        print(f"dropped {args.id}: {got['desc']} (delta={got['delta']:+.2f})")
    except KeyError:
        print(f"id not found: {args.id}"); sys.exit(1)

def view(args):
    data = load()
    notes = data["notes"]
    if args.scope == "agent" or args.agent:
        agent = args.agent or to_me()
        notes = [n for n in notes if n.get("agent") == agent]
    order = sorted(notes, key=lambda n: -n.get("importance", 0))
    if not args.all and args.top:
        order = order[:args.top]
    print(f"=== memo view ({args.scope}) top={args.top} ===")
    for i, n in enumerate(order):
        print(f"{i+1}. [{n.get('importance',0):.2f}] ({n.get('agent','?')}) #{n['id']} {n['desc']}")
        if n.get("note"): print(f"     note: {n['note']}")

def mlog(args):
    hist = read_all_history()
    if args.agent:
        hist = [h for h in hist if h.get("agent") == args.agent]
    shown = hist if args.all else hist[- (args.top or 30):]
    print(f"=== memo log ({len(shown)}/ {len(hist)} shown, 时间先后) ===")
    for r in shown:
        mark = {"insert": "+", "update": "~", "drop": "-"}.get(r.get("op"), "=")
        print(f"{mark} {hist_desc(r)}")

def review(args):
    """回顾: 按影响量 |delta| 找重大改变. (delta 由脚本在写历史时记录)"""
    hist = read_all_history()
    if args.agent:
        hist = [h for h in hist if h.get("agent") == args.agent]
    # 有 delta 的才参与排序(旧 .md 无 delta → 归入 '无影响量' 末段)
    with_d = [h for h in hist if h.get("delta") is not None]
    without_d = [h for h in hist if h.get("delta") is None]
    with_d.sort(key=lambda h: -abs(h.get("delta", 0)))
    sel = with_d[:args.top] if with_d else []
    print(f"=== memo review: 重大改变回顾 (按 |影响量| 排序, top={args.top}) ===")
    if not sel:
        print("  (暂无带影响量的历史; 新写入会记录 delta)")
    for r in sel:
        print(hist_desc(r))
    if without_d:
        print(f"  ...另有 {len(without_d)} 条旧 .md 记录无影响量(仅按时间列)")

def playbooks_dir():
    return os.path.normpath(PLAYBOOK_DIR)

def list_playbooks():
    d = playbooks_dir()
    out = []
    if not os.path.isdir(d):
        return out
    for fn in sorted(os.listdir(d)):
        if fn.endswith(".json"):
            try:
                with open(os.path.join(d, fn), encoding="utf-8") as f:
                    out.append(json.load(f))
            except Exception:
                pass
    return out

def load_playbook(slug):
    for pb in list_playbooks():
        if pb.get("slug") == slug:
            return pb
    return None

def playbook_list(args):
    pbs = list_playbooks()
    if not pbs:
        print("=== memo playbook: 暂无可用场景 ==="); return
    print(f"=== memo playbook ({len(pbs)}) ===")
    for pb in pbs:
        print(f"  {pb['slug']:20s} {pb['name']}")
        print(f"     {pb.get('distill','')}")
    print(f"\n提新场景: {GITHUB_REPO}")

def playbook_init(args):
    pb = load_playbook(args.name)
    if not pb:
        print(f"场景不存在: {args.name}"); print(f"可用: {[x['slug'] for x in list_playbooks()]}")
        sys.exit(1)
    if args.dry_run:
        print(f"=== 预览: 场景 {args.name} 将灌入 {len(pb['seeds'])} 条 ===")
        for s in pb["seeds"]:
            print(f"  [{s['importance']:.2f}] {s['desc']}")
        print("   (--dry-run 不写入; 删去该参数即应用)")
        return
    data = load()
    now = datetime.datetime.now().isoformat(timespec="seconds")
    added = 0
    seq = _next_seq()
    with memo_lock():
        for s in pb["seeds"]:
            new_id = f"pb-{pb['slug']}-{seq}"
            if any(n.get("desc") == s["desc"] for n in data["notes"]):
                print(f"  skip(已存在): {s['desc']}")
                continue
            entry = {
                "id": new_id, "desc": s["desc"], "importance": s.get("importance", 0.8),
                "agent": args.agent or "memo", "created": now, "updated": now,
                "note": s.get("note", ""), "_file": "", "seq": 0, "source": pb["slug"]
            }
            data["notes"].append(entry)
            append_history({"op": "insert", "id": new_id, "agent": args.agent or "memo",
                            "desc": s["desc"], "imp": s.get("importance", 0.8),
                            "seq": seq, "note": s.get("note", ""), "delta": s.get("importance", 0.8)})
            seq += 1
            added += 1
        order, renamed = renum(data)
    print(f"=== 场景 {args.name} 已灌入 memo({added} 条新种子) ===")
    for a, b in renamed:
        print(f"  renamed {a} -> {b}")

def playbook_route(args):
    query = args.query or ""
    pbs = list_playbooks()
    print("=== 可匹配的 memo playbook ===")
    for pb in pbs:
        print(f"  {pb['slug']:20s} {pb['name']}")
    print(f"\n输入意图(未匹配到合适场景时, 可提 GitHub issue):")
    print(f"  {GITHUB_REPO}")
    print(f"  title 建议: `new playbook: {query or '<你的场景>'}`")

def to_me():
    return os.getenv("PI_AGENT_ID") or os.getenv("AGENT_ID") or "me"

def memo_lock(timeout=10):
    """对 MEMO_DIR/.memo.lock 加独占锁的上下文管理器; 独立于数据文件,
    这样数据可同时被多进程读, 写变更串行化。"""
    return file_lock(LOCK_FILE, timeout)

# ---------- tidy / daydream ----------
def tidy(args):
    from collections import defaultdict
    data = load()
    notes = data["notes"]
    hist = read_all_history()
    print(f"=== memo tidy: 总结清理报告 (notes={len(notes)}, history={len(hist)}) ===")
    by_src = defaultdict(list)
    for n in notes:
        by_src[n.get("source") or n.get("agent") or "?"].append(n)
    print("\n[1] 按来源归类:")
    for k, lst in sorted(by_src.items()):
        imps = ", ".join(f"{n['desc']}({n.get('importance',0):.2f})" for n in lst)
        print(f"  {k}: {len(lst)}条 | {imps}")
    print("\n[2] 低重要性(<=0.3) 清理候选:")
    low = [n for n in notes if n.get("importance", 0) <= 0.3]
    if low:
        for n in low:
            print(f"  drop? #{n['id']} [{n.get('importance',0):.2f}] {n['desc']}")
    else:
        print("  无")
    print("\n[3] 疑似重复/可归并(按去空格后首8字匹配):")
    def norm(s):
        return "".join(ch for ch in s if not ch.isspace())[:8]
    seen, merged = {}, []
    for n in notes:
        key = norm(n.get("desc", ""))
        if not key: continue
        if key in seen: merged.append((seen[key], n))
        else: seen[key] = n
    if merged:
        for a, b in merged:
            print(f"  ? {a['id']}:{a['desc']}  vs  {b['id']}:{b['desc']}")
    else:
        print("  无(粗糙匹配无命中, 更审计义重复由 agent 判断)")
    drops = [r for r in hist if r.get("op") == "drop"][-6:]
    print("\n[4] 最近 drop 过的(可当重拾候选/历史回顾):")
    if drops:
        for r in drops:
            print(f"  曾drop{hist_desc(r)}")
    else:
        print("  无")
    print("\n[建议] 脚本已采集结构; 由 agent 判断哪些 update 权重/归并/drop, 再调对应命令落地。")

def daydream(args):
    import random
    hist = read_all_history()
    data = load()
    if not hist and not data["notes"]:
        print("=== memo daydream: 暂无任何历史, 先去写点 memo 吧 ==="); return
    n = max(1, args.n)
    print(f"=== memo daydream: 随机回望 ({len(hist)} 条历史) ===")
    drops = [r for r in hist if r.get("op") == "drop"]
    others = [r for r in hist if r.get("op") != "drop"]
    pool = drops + others if args.mix else drops
    if not pool:
        pool = others
    random.shuffle(pool)
    print(f"\n[灵感抽屉] 随机抽 {min(n, len(pool))} 条旧痕迹:")
    for r in pool[:n]:
        print(f"  {hist_desc(r)}")
    order = sorted(data["notes"], key=lambda x: -x.get("importance", 0))
    print("\n[对照] 现在仍在盯的 top3:")
    for x in order[:3]:
        print(f"  [{x.get('importance',0):.2f}] {x.get('desc','')}")
    print("\n[说明] 脚本只随机捞线索; 若某条值得重拾/成灵感, 由 agent 经 insert 记回当前本子。")

if __name__ == "__main__":
    p = argparse.ArgumentParser(prog="memo")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("insert")
    pi.add_argument("--desc", required=True)
    pi.add_argument("--importance", type=float, default=0.5)
    pi.add_argument("--agent", default=None)
    pi.add_argument("--note", default=None)
    pi.add_argument("--id", default=None)
    pi.set_defaults(fn=insert)

    pu = sub.add_parser("update")
    pu.add_argument("--id", required=True)
    pu.add_argument("--desc")
    pu.add_argument("--importance", type=float)
    pu.add_argument("--agent")
    pu.add_argument("--note")
    pu.set_defaults(fn=update)

    pd = sub.add_parser("drop")
    pd.add_argument("--id", required=True)
    pd.set_defaults(fn=drop)

    pv = sub.add_parser("view")
    pv.add_argument("--scope", choices=["workplace", "agent"], default="workplace")
    pv.add_argument("--agent", default=None)
    pv.add_argument("--top", type=int, default=10)
    pv.add_argument("--all", action="store_true")
    pv.set_defaults(fn=view)

    pl = sub.add_parser("log")
    pl.add_argument("--agent", default=None)
    pl.add_argument("--top", type=int, default=30)
    pl.add_argument("--all", action="store_true")
    pl.set_defaults(fn=mlog)

    pr = sub.add_parser("review")
    pr.add_argument("--top", type=int, default=5)
    pr.add_argument("--agent", default=None)
    pr.set_defaults(fn=review)

    ptd = sub.add_parser("tidy")
    ptd.set_defaults(fn=tidy)

    pdd = sub.add_parser("daydream")
    pdd.add_argument("--n", type=int, default=3)
    pdd.add_argument("--mix", action="store_true")
    pdd.set_defaults(fn=daydream)

    ppb = sub.add_parser("playbook")
    ppb_sub = ppb.add_subparsers(dest="pcmd")
    ppb_list = ppb_sub.add_parser("list"); ppb_list.set_defaults(pfn=playbook_list)
    ppb_init = ppb_sub.add_parser("init")
    ppb_init.add_argument("--name", required=True)
    ppb_init.add_argument("--dry-run", action="store_true")
    ppb_init.add_argument("--agent", default=None)
    ppb_init.set_defaults(pfn=playbook_init)
    ppb_route = ppb_sub.add_parser("route")
    ppb_route.add_argument("--query", default=None)
    ppb_route.set_defaults(pfn=playbook_route)

    a = p.parse_args()
    if hasattr(a, "pfn"):
        a.pfn(a)
    else:
        a.fn(a)